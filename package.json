{
    "name": "moleculer-sidecar-next",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "exports": {
        ".": {
            "import": "./src/index.ts"
        }
    },
    "main": "index.js",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "start": "tsx ./node_modules/moleculer/bin/moleculer-runner.mjs --config ./moleculer.config.ts -e --hot ./src/services/*.service.ts",
        "start:lab": "tsx ./node_modules/moleculer/bin/moleculer-runner.mjs --config ./moleculer.config.ts -e --hot ./src/services/lab.service.ts",
        "start:dev": "tsx ./node_modules/moleculer/bin/moleculer-runner.mjs --config ./moleculer.config.ts -e --hot"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.6.4",
    "dependencies": {
        "@fastify/busboy": "^3.1.1",
        "@moleculer/lab": "^0.6.4",
        "body-parser": "^1.20.3",
        "cbor-extract": "^2.2.0",
        "cbor-x": "^1.6.0",
        "dotenv": "^16.4.7",
        "form-data": "^4.0.2",
        "is-stream": "^4.0.1",
        "kleur": "^4.1.5",
        "lodash": "^4.17.21",
        "moldecor": "github:mishatre/moldecor#heads/next",
        "moleculer": "0.14.35",
        "moleculer-db": "^0.8.28",
        "moleculer-db-adapter-sequelize": "^0.2.19",
        "moleculer-sidecar-next": "link:",
        "nats": "^2.29.3",
        "sequelize": "^6.37.6",
        "sqlite3": "^5.1.7",
        "type-is": "^1.6.18",
        "xml2js": "^0.6.2",
        "yaml": "^2.7.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/body-parser": "^1.19.5",
        "@types/formidable": "^3.4.5",
        "@types/lodash": "^4.17.16",
        "@types/node": "^22.13.10",
        "@types/type-is": "^1.6.7",
        "@types/xml2js": "^0.4.14",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "cbor-extract",
            "esbuild",
            "sqlite3"
        ]
    }
