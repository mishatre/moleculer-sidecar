{
    "name": "moleculer-sidecar",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "exports": {
        ".": {
            "import": "./src/index.ts"
        }
    },
    "main": "index.js",
    "bin": {
        "moleculer-sidecar": "dist/cli.mjs"
    },
    "files": [
        "dist",
        "src",
        "ui/dist"
    ],
    "scripts": {
        "build": "pnpm run build:ui && pnpm run build:server",
        "build:server": "node scripts/build-server.mjs",
        "build:ui": "pnpm --dir ui run build",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "prepack": "pnpm run build",
        "package:all": "pnpm run build && node scripts/pack.mjs",
        "package:linux": "pnpm run build && node scripts/pack.mjs --targets linux-x64",
        "package:win": "pnpm run build && node scripts/pack.mjs --targets win-x64",
        "start": "tsx ./src/index.ts",
        "start:lab": "tsx ./src/index.ts --lab",
        "start:ui": "tsx ./src/index.ts --ui",
        "start:dev": "tsx watch ./src/index.ts",
        "test": "vp test",
        "ui:password": "tsx ./scripts/ui-password.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@12.5.1",
    "dependencies": {
        "@fastify/busboy": "^3.1.1",
        "@moleculer/lab": "^1.0.0",
        "body-parser": "^1.20.3",
        "cbor-extract": "^2.2.0",
        "cbor-x": "^1.6.0",
        "dotenv": "^16.4.7",
        "form-data": "^4.0.2",
        "is-stream": "^4.0.1",
        "kleur": "^4.1.5",
        "lodash": "^4.17.21",
        "moldecor": "^2.0.0-rc.3",
        "moleculer": "0.14.35",
        "moleculer-db": "^0.8.28",
        "moleculer-db-adapter-sequelize": "^0.2.19",
        "moleculer-sidecar": "link:",
        "moleculer-web": "^0.10.8",
        "nats": "^2.29.3",
        "sequelize": "^6.37.6",
        "sqlite3": "^5.1.7",
        "type-is": "^1.6.18",
        "xml2js": "^0.6.2",
        "yaml": "^2.7.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/body-parser": "^1.19.5",
        "@types/formidable": "^3.4.5",
        "@types/lodash": "^4.17.16",
        "@types/node": "^22.13.10",
        "@types/type-is": "^1.6.7",
        "@types/xml2js": "^0.4.14",
        "@yao-pkg/pkg": "^6.22.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2",
        "vite-plus": "0.3.3"
    }
}
