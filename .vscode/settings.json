{
    // Biome is the single formatter/linter for this workspace. Prettier and
    // ESLint were removed from the project; their editor extensions are kept
    // quiet here so a second toolchain can't reformat or re-lint these files.
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.biome": "explicit",
        "source.organizeImports.biome": "explicit"
    },
    "[typescript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[javascript]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[json]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    "eslint.enable": false,
    "prettier.enable": false,

    // Hooks run shell commands, so an agent that can rewrite them can rewrite its
    // own guardrails. Edits under .github/hooks/** require manual approval.
    "chat.tools.edits.autoApprove": {
        "**/.github/hooks/**": false
    }
}
