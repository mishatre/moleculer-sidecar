{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["src", "vite.config.ts"]
}
